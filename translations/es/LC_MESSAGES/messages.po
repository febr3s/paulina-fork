#: templates/countries.html:10
msgid ""
"This grid indicates the period after which works enter the public domain "
"in each country."
msgstr ""
"Esta grilla indica el período luego del cual las obras entran en dominio "
"público en cada país."

#: templates/countries.html:11
msgid "The period indicated is post mortem auctoris."
msgstr "El plazo indicado es post mortem auctoris."

#: templates/countries.html:12
msgid ""
"By clicking on each country, you can access more information about the "
"country."
msgstr "Haciendo clic en un país, se accede a más información acerca del país."

